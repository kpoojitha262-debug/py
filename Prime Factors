import java.util.ArrayList;

class Main {
    public static ArrayList<Integer> primeFactor(int n) {
        ArrayList<Integer> ans = new ArrayList<>();
        for (int i = 2; i <= n; i++) {
            while (n % i == 0 && n > 0) {
                ans.add(i);
                n = n / i; 
            }
        }
        return ans;
    }  
    public static void main (String[] args) {
        int n = 18;
        ArrayList<Integer> ans = primeFactor(n);
        for (int x : ans) {
            System.out.print(x + " ");
        }
    }
}
